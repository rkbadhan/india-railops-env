# Copy this file to .env and fill the key locally. Never paste or commit a key.
# Existing environment variables and explicit worker flags take precedence.
OPENAI_BASE_URL=https://api.fireworks.ai/inference/v1
OPENAI_API_KEY=
# FIREWORKS_API_KEY= is also accepted when OPENAI_API_KEY is empty.

# Fallback for direct worker requests without a model id; the harness model
# config and explicit --model flags take precedence.
OPENAI_MODEL=accounts/fireworks/models/deepseek-v4p1-flash-1017

# Evaluation window/output budgets are declared in:
# examples/models_fireworks_deepseek.json
